# ==========================================
# Cloud-Native Document & Media Vault
# Environment Configuration Template
# NOTE: Copy this file to .env and fill in real values.
# NEVER commit the .env file to Git!
# ==========================================

# Server Port and Environment
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection String (M0 Free Tier)
# Format: mongodb+srv://<username>:<password>@<cluster-url>/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://vaultuser:your_password_here@vault-cluster.xxxx.mongodb.net/vaultdb?retryWrites=true&w=majority

# Azure Blob Storage Configuration
# Found under Azure Portal -> Storage Account -> Security + networking -> Access keys -> Connection string
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=yourstorageaccountname;AccountKey=your_base64_account_key==;EndpointSuffix=core.windows.net

# Container name created in Azure Blob Storage
AZURE_STORAGE_CONTAINER_NAME=vault-files

# JWT Secret and Expiration for Authentication
JWT_SECRET=your_super_strong_random_jwt_secret_key_minimum_32_chars
JWT_EXPIRES_IN=7d

# Shared Access Signature (SAS) Expiry in Minutes (Default: 15 minutes)
SAS_EXPIRY_MINUTES=15
